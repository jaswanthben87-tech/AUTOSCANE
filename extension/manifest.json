{
  "manifest_version": 3,
  "name": "Ask Gemini AutoScan",
  "version": "1.2.0",
  "description": "Scan visible questions locally with OCR and show Gemini answers on the same webpage.",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Scan visible questions with Ask Gemini AutoScan" },
  "commands": {
    "scan-question": {
      "suggested_key": { "default": "Ctrl+Shift+Q" },
      "description": "Automatically scan visible questions"
    }
  },
  "host_permissions": ["http://127.0.0.1:3037/*", "https://*.vercel.app/*", "<all_urls>"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self';" }
}
